# =====================================================================
# Arquivo  : .env.example
# Objetivo : modelo do .env com as conexoes usadas pelo Python
# Etapa    : E0 - Ambiente
# Uso      : copiar para .env na raiz do projeto e preencher as senhas;
#            o .env nao e versionado (credenciais so nele)
# Obs      : HOST = localhost quando o WSL encaminha as portas; se nao
#            encaminhar, o IP da maquina Podman, que muda a cada
#            reinicio: wsl -d podman-machine-default hostname -I
#          : senha com # ou espaco: escrever entre aspas simples
# =====================================================================

# Oracle XE 21c - staging (usuario STAGING no PDB XEPDB1)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=STAGING
ORACLE_PASSWORD=

# SQL Server 2022 - espelho, DW e log (login sa, decisao D21)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1434
SQLSERVER_DATABASE=db_pnad_covid
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# o ODBC 18 criptografa por padrao e o certificado do container e
# autoassinado: yes = confiar no certificado (ambiente de laboratorio)
SQLSERVER_TRUST_CERT=yes
